# ============================================================================
# ONYX LABS — CONFIGURATION ENVIRONNEMENT (.env.example)
# Copiez ce fichier vers `.env` et renseignez vos identifiants réels.
# Aucune clé secrète ne doit être committée dans le dépôt Git.
# ============================================================================

# Endpoint API pour le formulaire de contact et de demande de devis
# Ex: https://api.onyxlabs.io/v1/inquiries ou endpoint Formspree / Web3Forms
VITE_CONTACT_ENDPOINT=""
VITE_QUOTE_ENDPOINT=""

# Coordonnées officielles configurables
VITE_CONTACT_EMAIL="contact@onyxlabs.dev"
VITE_WHATSAPP_NUMBER="+237600000000"
VITE_CALENDLY_URL="https://cal.com/onyx-labs"

# URL canonique pour le SEO et Open Graph
VITE_SITE_URL="https://onyxlabs.dev"
